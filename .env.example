# Αντίγραψέ το σε .env.local και άλλαξε τον κωδικό.
# Copy this to .env.local and change the password.

ADMIN_PASSWORD=change-me-please

# Τυχαία μεγάλη συμβολοσειρά: υπογράφει το cookie του admin.
# Random long string: signs the admin cookie.
ADMIN_SECRET=replace-with-a-long-random-string

# Supabase. Και τα δύο είναι υποχρεωτικά, τοπικά και στην παραγωγή.
# Supabase. Both are required, locally and in production.
#
# Dashboard → Project Settings → API
#
# ΠΡΟΣΟΧΗ: χρειάζεται το service_role key, ΟΧΙ το anon/public. Το anon δεν
# παρακάμπτει το RLS, οπότε οι εγγραφές θα αποτυγχάνουν σιωπηλά. Το service_role
# δεν πρέπει ΠΟΤΕ να φτάσει στον browser — χρησιμοποιείται μόνο server-side.
#
# NOTE: this must be the service_role key, NOT the anon/public one. Never expose
# service_role to the browser; it is used server-side only.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
